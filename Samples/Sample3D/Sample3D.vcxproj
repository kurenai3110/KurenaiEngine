  <ItemDefinitionGroup>
    <!-- KurenaiEngineLibrary.dll/KurenaiEngine3D.dllとそれが参照するShaders・Assetsを、
         プロジェクト参照のビルドで生成された出力フォルダ・リポジトリのAssetsから
         実行ファイルと同じフォルダへコピーする。AssetsはKurenaiEngine3D.dll側の出力に
         置かず、ここで直接コピーする(3D DLLのOutDirを変えるたびに増殖させないため) -->
    <PostBuildEvent>
      <Command>set KURENAI_BIN=$(ProjectDir)..\..\Build\Bin\$(Platform)\$(Configuration)
xcopy /Y /I /D "%KURENAI_BIN%\KurenaiEngineLibrary\*.dll" "$(OutDir)"
xcopy /Y /I /D "%KURENAI_BIN%\KurenaiEngine3D\*.dll" "$(OutDir)"
xcopy /Y /I /E /D "%KURENAI_BIN%\KurenaiEngine3D\Shaders" "$(OutDir)Shaders\"
xcopy /Y /I /E /D "$(ProjectDir)..\..\Assets\Packed" "$(OutDir)Assets\"
exit /b 0</Command>
      <Message>KurenaiEngineLibrary/3D・シェーダー・AssetsをOutDirへコピー</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
