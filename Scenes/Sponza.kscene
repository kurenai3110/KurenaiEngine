# KurenaiEngine シーンファイル

[Scene]
Name = Sponza

[Model]
Path = Sponza/Sponza.kmodel

# 反射プローブ: 屋内のため、スカイボックス由来のグローバルIBLのままだと金属面に空が映り込んで
# しまう。実際の柱・壁・床が映るようにするためのもの。
#
# アトリウム(長辺がX方向、約30 x 12 x 18)を2つに分けて置く。1つで足りる広さではあるが、
# プローブ間のブレンドと視差補正の効きを見比べられるよう、Xの中央付近で重なるようにしてある。
# Shape = Box にすると影響範囲が部屋の形に沿うだけでなく、反射ベクトルをこの箱と交差させる
# 視差補正が効くようになる(壁際で反射位置がずれなくなる)。
# BoxExtentsは部屋の壁とほぼ一致させる — 視差補正はこの箱を壁とみなして交点を求めるため、
# 実際の壁から大きく離すと反射位置がずれる。逆に小さすぎると壁面自体が影響範囲の外へ出てしまう
[ReflectionProbe]
Name = Atrium West
Position = -8.0, 5.0, 0.0
Shape = Box
BoxExtents = 10.0, 6.5, 10.0
BlendDistance = 1.0

[ReflectionProbe]
Name = Atrium East
Position = 7.0, 5.0, 0.0
Shape = Box
BoxExtents = 10.0, 6.5, 10.0
BlendDistance = 1.0
