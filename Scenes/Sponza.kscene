# KurenaiEngine シーンファイル

[Scene]
Name = Sponza

[Model]
Path = Sponza/Sponza.kmodel

# 反射プローブ: 屋内のため、スカイボックス由来のグローバルIBLのままだと金属面に空が映り込んで
# しまう。実際の柱・壁・床が映るようにするためのもの。
#
# アトリウム(長辺がX方向、約30 x 12 x 18)を2つに分けて置く。1つで足りる広さではあるが、
# プローブ間のブレンドと視差補正の効きを見比べられるよう、Xの中央付近で重なるようにしてある。
# Shape = Box にすると影響範囲が部屋の形に沿うだけでなく、反射ベクトルをこの箱と交差させる
# 視差補正が効くようになる(壁際で反射位置がずれなくなる)。
# BoxExtentsは部屋の壁とほぼ一致させる — 視差補正はこの箱を壁とみなして交点を求めるため、
# 実際の壁から大きく離すと反射位置がずれる。逆に小さすぎると壁面自体が影響範囲の外へ出てしまう
[ReflectionProbe]
Name = Atrium West
Position = -8.0, 5.0, 0.0
Shape = Box
BoxExtents = 10.0, 6.5, 10.0
BlendDistance = 1.0

[ReflectionProbe]
Name = Atrium East
Position = 7.0, 5.0, 0.0
Shape = Box
BoxExtents = 10.0, 6.5, 10.0
BlendDistance = 1.0

# DDGIボリューム(M11 Stage 2): 拡散の間接光をDDGIへ一本化したため(31章)、プローブを持つ
# シーンにボリュームが無いと位置依存の拡散を丸ごと失いグローバルIBLだけになってしまう。
# 上のReflectionProbe 2個のBoxExtentsは「部屋の壁とほぼ一致させる」規約で置かれているため
# (17行目のコメント参照)、その2つのAABBの和からアトリウムの内寸をそのまま読み取れる:
#   X: [-18, 17]  Y: [-1.5, 11.5]  Z: [-10, 10]
# これを2 m前後の間隔で壁から少し内側へ避けて敷いている。ただし19.13節のような
# ジオメトリを直接測る手順は踏んでおらず、上記2つの箱の座標から機械的に算出した値である。
# 実機での見た目の確認(床への壁色の回り込み、境界での不連続の有無)はまだ行っていない
[GIVolume]
Name = Atrium
Origin = -16.0, 0.0, -8.5
ProbeSpacing = 2.0, 1.6, 2.0
ProbeCounts = 16, 8, 9
NormalBias = 0.25
ViewBias = 0.10
Hysteresis = 0.97
MaxRayDistance = 8.0
