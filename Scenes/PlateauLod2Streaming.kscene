# KurenaiEngine シーンファイル - PLATEAU 建築物 LOD2 のテクスチャ常駐ミップ検証
#
# 【何を確かめるためのものか】
#   1. PLATEAU LOD2 で常駐ミップ制御がどのサイズ帯にどれだけ効くか
#      【サイズ帯ごとに分けて読むこと】全体の削減率だけでは
#      「どこに効いたか」が分からない。タイルリソース（64KBタイル＝BC7で256x256）は
#      大きいテクスチャにしか乗らないので、帯を分けないと効果を取り違える
#   2. モデルのストリーミングと同居させて壊れないこと
#      モデルが出入りすると、追跡表への付け外し（Attach/Detach）と、
#      読み直し中のテクスチャを択えたままモデルを破棄する危険が出る
#
# 【LOD2 は3タイルしか焼けていない】西新宿(53394525) と 丸の内(53394600/53394601)。
# 23区全域の確認にはならない。テクスチャは合計 5,094 枚（1714 + 1179 + 2201）。
#
# 【地形と道路は丸の内側にしか無い】dem/tran は2次メッシュ 533946 だけがパック済みで、
# 西新宿(533945)側には無い。西へ飛ぶと建物が宙に浮くが、ここで見たいのは
# ファサードのテクスチャなのでそのままにしてある。
#
# 出典・ライセンス・変換コマンドは PlateauMarunouchi.kscene を参照。

[Scene]
Name = PLATEAU LOD2 テクスチャ常駐ミップ検証
ShadowDistance = 500
CameraSpeed = 60

# 【モデルのストリーミングを入れる】丸の内と西新宿は約5.9km離れているので、
# 1500m なら片方にいる間はもう片方が外れている。行き来すれば Attach/Detach が両方走る
StreamingDistance = 1500

# 【常駐ミップ制御を有効にする】バイアスは既定値(-2.0)のまま使う。
# 既定値の根拠は docs/ImplementationDetail.md 48.3 にある
TextureStreaming = true

# 【霓を切る】建物のファサードが白く飛ぶと、ミップを落としすぎてぼけたのか
# 霓で潰れたのかを区別できない
[Fog]
Enabled = false

# 【雲を消す】雲はフレームごとに流れるため、設定を変えずに撮った2枚でも空の画素が変わる。
# A/B のノイズ下限を 0 にしておかないと、差分がミップのせいか空のせいか分からない
[Cloud]
Coverage = 0.0

# --- 建築物 LOD2 ---------------------------------------------------------------
[Model]
Path = Plateau/BldgLod2/53394600.kmodel

[Model]
Path = Plateau/BldgLod2/53394601.kmodel

[Model]
Path = Plateau/BldgLod2/53394525.kmodel

# --- 橋梁・地形・道路（丸の内側のみ） -------------------------------------
[Model]
Path = Plateau/Brid/53394600.kmodel

[Model]
Path = Plateau/Brid/53394601.kmodel

[Model]
Path = Plateau/Dem/533946.kmodel

[Model]
Path = Plateau/Tran/533946.kmodel

# 【カメラは PlateauMarunouchi.kscene と同じ】建物の内部に入らない高さ（120m）で、
# ビル群の壁面を正面に入れる。ファサードが画面の大半を占めることが、
# ミップを落としすぎたときに気づける条件になる
[Camera]
Position = 1100.0, 120.0, -400.0
Yaw = 90.0
Pitch = -12.0

[Sun]
TimeOfDay = 10.0
Shadow = true
