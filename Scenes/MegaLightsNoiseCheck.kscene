# KurenaiEngine シーンファイル - MegaLights のノイズ測定用
#
# docs/ImplementationDetail.md 61.7f / 61.7g のノイズの実測は、すべてこのシーンで取った。
# もともとリポジトリの外(ビルド出力の Assets\Scenes\_MLCheck.kscene)にしか無く、
# 測定を再現することも反証することもできない状態だったので、正式に Scenes/ へ置いた。
#
# BistroInteriorLit.kscene からの差分は次の4点だけで、いずれも測定を決定的にするためのもの:
#   1. Exposure = 2.0 を明示     … 自動露出の整定(遅い起動で17秒)が蓄積ウォームアップ
#                                   (180フレーム)より長く、整定中に蓄積すると汚染される
#   2. TimeOfDay = 0.0           … 夜。太陽の寄与を完全に消してローカルライトだけにする
#   3. GIVolume を持たない       … DDGI の寄与が混ざると MegaLights だけを切り分けられない
#   4. カメラが違う              … 器具が視界に多く入り、影の重なりが見える位置
#
# 使い方(必ず -autoexposure 0 と組で):
#   参照実装:   Sample3D.exe -scene MegaLightsNoiseCheck -dx12 -autoexposure 0 ^
#                 -megalights 1 -megalightsaccum 900 -megalightsdump ref.bin
#   確率的:     Sample3D.exe -scene MegaLightsNoiseCheck -dx12 -autoexposure 0 ^
#                 -megalights 2 -megalightsaccum 1   -megalightsdump one.bin
#   誤差は「参照実装を分母にした |相対誤差| の中央値」で見る(61.7g 冒頭の注意)。
#   RMSE は輝度 10^7 級の画素に支配されるので物差しにならない。
#
# 以下、BistroInteriorLit.kscene のコメントをそのまま引き継ぐ。

[Scene]
Name = MegaLights Noise Check
# 測定を決定的にするための固定露出。自動露出の整定(遅い起動で17秒)が
# 蓄積ウォームアップ(180フレーム)より長く、整定中に蓄積すると汚染されるため。
# -autoexposure 0 と組で使う
Exposure = 2.0
# 既定値と同じ0.5だが、明示しておく。プローブの寄与もグローバルIBLと同じこの倍率で
# スケールされるため、ここを下げるとプローブごと薄まって上記1.の比較が成立しなくなる
IBLIntensity = 0.5

[Model]
Path = BistroMcGuire/Interior.kmodel

# 客席側の手前からカウンターの方向を見る位置。左手に客席と奥の間、右手にバックバーが入る。
# シーン読み込み直後にプローブが自動ベイクされるため、その時点で3つのプローブの領域が
# なるべく視界に入るようにしてある(カスケードシャドウマップがカメラ視錐台にフィットするので、
# 見えていない領域はベイク時に影が乗らない)。
#
# Yaw/Pitchは度(ドキュメント4.7節)。ラジアンで書くと約57分の1の角度になるので注意。
# またYawは+Z軸を0度、+X軸を90度として測る(Camera::GetForwardが
# forward=(cos(pitch)sin(yaw), sin(pitch), cos(pitch)cos(yaw)))。
# atan2(dz,dx)ではなくatan2(dx,dz)である点に注意
[Camera]
Position = 6.2, 2.6, 0.2
Yaw = 92.4
Pitch = -10.6

# 部屋は天井(y=4.20)で閉じており窓の開口も小さいため、太陽光が直接床へ差し込むことはほぼ無い。
# TimeOfDayが実質決めているのは「空のIBL経由の環境光の強さ」で、KurenaiEngine3D.cppの
#   dayFactor = Smoothstep(6,7,t) * (1 - Smoothstep(17,18,t))
# がその倍率になる。つまり17時までは昼のまま(dayFactor=1)、18時ちょうどで完全に0になり、
# 夕方の遷移はこの17〜18時の1時間に全部詰まっている。
#
# 17.9 を選んだのは、この2つを同時に満たす必要があるため:
#   ・照明器具15灯が主役に見えること   → 空が明るいと器具の寄与が埋もれる
#   ・反射プローブの効果が見えること   → 空が完全に0(18.0以降)だとプローブと
#                                        グローバルIBLの差が消え、ON/OFFで絵が1画素も変わらない
# 17.9 は dayFactor ≈ 0.028。空はわずかに残るだけなので店内は暖色の器具光が支配し、
# それでいてプローブを切ると床と椅子に空の青が乗る(=違いがはっきり見える)。
# 18.0にすると見た目は近いままプローブの検証だけができなくなるので、下げないこと
[Sun]
TimeOfDay = 0.0
Shadow = true

# ------------------------------------------------------------------------------------------
# 照明器具(15灯)
#
# 位置は Interior.kgeom の頂点をメッシュ単位でクラスタリングして求めた器具の重心。
# 電球がシェードのジオメトリに埋まらないよう、吊り下げ・ランタンはシェード重心より少し下げ、
# 壁付けは部屋の内側へ0.25だけオフセットしてある。
#
# CastShadowの振り分けは意図的なもの。ピクセルあたりのシャドウレイ数には上限があり
# (Lighting > Max Shadowed Lights per Pixel、既定4本)、全灯をtrueにすると予算が先着順に
# 食い潰されてどの影も安定しない。そこで「接触影が絵に効く器具」(椅子・テーブル・瓶を
# 上から照らす吊り下げとランタン)だけtrueにし、壁を舐めるだけで接触影がほぼ見えない
# 壁付け照明はfalseにしている
# ------------------------------------------------------------------------------------------

# --- 吊り下げランプ 4灯(メッシュ Paris_Ceiling_Lamp_01。シェード重心 y=3.54) ---
# 部屋の主光源。ここだけRangeを広めに取り、隣の器具と重ねて全体の下地を作る

[Light]
Type = Point
Position = 7.98, 3.35, -1.00
Color = 1.00, 0.72, 0.45
Intensity = 2500.0
Range = 9.0
CastShadow = true

[Light]
Type = Point
Position = 5.00, 3.35, 0.50
Color = 1.00, 0.72, 0.45
Intensity = 2500.0
Range = 9.0
CastShadow = true

[Light]
Type = Point
Position = 4.25, 3.35, 4.93
Color = 1.00, 0.72, 0.45
Intensity = 2500.0
Range = 9.0
CastShadow = true

# 奥の間の1灯だけシェードが低い(重心y=3.39)ため、電球も同じだけ下げる
[Light]
Type = Point
Position = 6.11, 3.20, 8.49
Color = 1.00, 0.72, 0.45
Intensity = 2500.0
Range = 9.0
CastShadow = true

# --- バーのランタン 4灯(メッシュ Paris_Lantern_01A。重心 y=2.92) ---
# カウンター(天板 y=1.72)の直上1m強にあるアクセント光。距離が近いぶんIntensityは低くてよく、
# Rangeを狭めてカウンター周りに光だまりを作る。瓶とグラスの接触影がここで出る

[Light]
Type = Point
Position = 10.37, 2.80, 1.05
Color = 1.00, 0.62, 0.32
Intensity = 700.0
Range = 6.0
CastShadow = true

[Light]
Type = Point
Position = 8.80, 2.80, 1.92
Color = 1.00, 0.62, 0.32
Intensity = 700.0
Range = 6.0
CastShadow = true

[Light]
Type = Point
Position = 7.22, 2.80, 2.79
Color = 1.00, 0.62, 0.32
Intensity = 700.0
Range = 6.0
CastShadow = true

[Light]
Type = Point
Position = 6.62, 2.80, 4.21
Color = 1.00, 0.62, 0.32
Intensity = 700.0
Range = 6.0
CastShadow = true

# --- 壁付け照明 7灯(エミッシブの電球メッシュ。y=2.55) ---
# 前3灯は正面側の壁、次の3灯(-0.73 / 0.72 / 2.14)はカーテンのある側の壁に並ぶ。
# 残り1灯(7.57)はカウンター奥のブラケットランタン

