# KurenaiEngine シーンファイル - White Furnace Test
# 検証の成立条件は docs/Architecture.html 14.9.7 参照

[Scene]
Name = White Furnace Test
Skybox = Skybox/UniformWhite.dds
IBLIntensity = 1.0
AmbientOcclusion = false
# SSRは以前ここでfalseにしていた。鏡面IBLへ反射色を「加算」する設計だったため二重計上が起き、
# 球が背景より明るくなって検証が成立しなかったのが理由(14.9.5節)。
# 20章でSSRを「加算」から「環境の放射輝度の差し替え」へ変えて二重計上を解消したので、
# 有効に戻してある。これにより、このシーンはSSRの合成が壊れていないことの回帰テストも兼ねる
# (球が背景から浮き上がって見えたらSSR側の合成が壊れている)
ScreenSpaceReflection = true

[Model]
Path = FurnaceTest/FurnaceTest.kmodel

[Sun]
Enabled = false

# DDGI(22章)の正規化を検証するためのプローブ格子。
#
# このシーンは一様な白の環境光しか無いので、開けた場所のプローブはどの方向を見ても同じ放射輝度Lを
# records する。一様なLに対するイラディアンスは E = πL、DDGIが格納するのは E/π = L なので、
# **DDGIのイラディアンスはグローバルIBLのそれと一致しなければならない**。
# つまりDDGIのON/OFFで球の見た目が変わらないことが、積分と正規化(立体角の重み付け・
# コサイン重みの分母)が正しいことの検証になる。逆に変わるなら正規化がどこかで狂っている。
#
# 格子はプローブが球の内部へ入らないように置く(球はy=0,z=0の軸上に半径1で並ぶため、
# YとZの格子点が0を踏まないよう1.5ずらしてある)。中に入ったプローブは球の内側の
# 真っ暗な面しか見えず、検証と無関係な暗点になる。
#
# 【プローブ分類を入れたあとに実測したこと】ずらしを外した格子
# (Origin Y/Z = -6.0、ProbeCounts = 11,5,5)でも試した:
#   - 球の内部に入った5個のプローブは、裏面ヒット率がほぼ1.0として正しく検出される
#     (残り96.7%は0.05未満。きれいな二山になる)
#   - ただし**最終的な絵は分類の有無に関わらず一様202で変わらなかった**。
#     この格子の粗さでは、埋まったプローブが球の見た目に影響していない
# つまりずらしを外しても壊れないが、外して得られるものも無いので、
# 検証の基準線を動かさないためにずらしたまま残してある
[GIVolume]
Name = Furnace
Origin = -15.0, -4.5, -4.5
ProbeSpacing = 3.0, 3.0, 3.0
ProbeCounts = 11, 4, 4
NormalBias = 0.25
ViewBias = 0.10
Hysteresis = 0.97
MaxRayDistance = 12.0
