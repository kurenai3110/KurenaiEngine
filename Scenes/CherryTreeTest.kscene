# KurenaiEngine シーンファイル - 桜(ソメイヨシノ)のMeshShader描画検証用
#
# モデルは Tools/blender_cherry_tree.py が手続き生成する
# (Assets/Source/CherryTree/ → KurenaiPacker.exe で Assets/Packed/CherryTree/ へ変換):
#   CherryTree_s1/s2/s3.kmodel … 乱数シード違いの3個体(枝ぶりと花の散布が変わる)
#   CherryGround.kmodel        … 90m四方の草地
#
# --- なぜ3個体を1シーンに並べるのか ---
# 手続き生成の見た目は1枚では判定できない(「1枚は分布ではない」)。シード違いを
# 3本並べて同時に撮ることで、樹形の当たり外れを1回の起動で見られるようにする。
# さらに**シーンを切り替えるとEV100(自動露出)が引き継がれる**既知の罠があるため、
# 起動1回・シーン切替なしで全個体を撮れる構成にしてある(カメラのA/D移動だけで足りる)。
#
# --- 配置 ---
# 1単位=1メートル。木の原点は根元(接地点)。樹高6.9〜8.1m・樹冠幅9〜10.5mなので、
# 樹冠が重ならないよう X方向に20m間隔で並べる。カメラの初期位置は1本目の正面。

[Scene]
Name = Cherry Tree Test
# 屋外の風景なのでトーンマップはACESにする(既定のAgXは広い面の彩度を落とすため、
# 淡紅色の花の色を見る用途には向かない)。MontSaintMichel.ksceneと同じ理由
Tonemap = ACES
# 露出はエンジンの既定値と同じだが、明示的に書いて固定する。
# 【なぜ書くか】シーンをまたぐとEV100が引き継がれるため、審査のたびに空の明るさが
# 動くと「変更のせい」と「露出のせい」を切り分けられなくなる
Exposure = 15.0
# TAAは切る。時間方向に蓄積するのでフレームレートの揺れがそのまま画素差になり、
# A/B比較の再現性の下限が取れなくなる(ab-compareスキル)。
# 花カードのような1画素未満の細い構造はTAAでもちらつきが残る
TAA = false
# 内部レンダー解像度。**実効解像度は判定そのものを動かす**ため明示的に固定する。
# 既定の1280x720では樹冠の花房が数画素になり、「板っぽさ」も「花房の塊感」も
# 拡大のぼけに埋もれて審査にならない(モン・サン=ミシェルで、揃えずに比べて
# 4〜5倍と見た差が実は1.4〜2.7倍だった前例がある)。幹のクローズは
# この解像度のレンダから切り出して作る
RenderResolution = 3840, 2160

[Model]
Path = CherryTree/CherryGround.kmodel
Translation = 0, 0, 0

[Model]
Path = CherryTree/CherryTree_s1.kmodel
Translation = 0, 0, 0

[Model]
Path = CherryTree/CherryTree_s2.kmodel
Translation = 20, 0, 0

[Model]
Path = CherryTree/CherryTree_s3.kmodel
Translation = 40, 0, 0

# カメラは1本目の正面(-Z側)。Yaw=0で+Z方向を向く
# (Camera::GetForward: forward=(cos(pitch)sin(yaw), sin(pitch), cos(pitch)cos(yaw))。
#  yaw=0, pitch=0 を代入すると forward=(0,0,1))。
# **+X はこのカメラから見て右**なので、A/Dの左右移動だけで s1→s2→s3 を撮れる
# (視点回転は右クリックドラッグが要り自動化に向かないため、回転を使わない構図にした)。
# 樹高8m・樹冠幅10mが画角に収まる距離として15mを取り、視線の高さは目線相当の1.7m、
# 樹冠の中心(高さ4.5m前後)を見上げすぎない程度にPitchを10度上げる
[Camera]
Position = 0, 1.7, -15
Yaw = 0
Pitch = 10

# 太陽。**順光にしない**(順光では影が出ず、枝ぶりも花房の塊も造形が消えるため審査にならない。
# モン・サン=ミシェルで実測済み: 方位を順光から振ると輝度の変動係数が0.254→0.412まで動いた)。
#
# このエンジンの太陽は方位角の鉛直面内を回る半円で、仰角 = (TimeOfDay/24)*360 - 90 度。
#   TimeOfDay 8.0 → 仰角30度
# 仰角30度は、枝が落とす影が地面へ十分に伸びて樹冠の立体感が出る一方、
# 15度まで下げたときのような極端な逆光にはならない高さとして採った。
#
# AzimuthDegrees は日の出の水平方向(X=0度, +Z=90度)。180度なら太陽は -X 側、
# つまり**カメラから見て左**にある。200度にして左やや手前からの斜光にすることで、
# 樹冠の右側に影が回り込み、枝の前後関係が読めるようにする
[Sun]
TimeOfDay = 8.0
AzimuthDegrees = 200.0
