# KurenaiEngine シーンファイル - メッシュレット / bindless / レイトレーシングの検証用
#
# 内容:
#   ・McGuireのChinese Dragon(87万三角形の3Dスキャン)。メッシュレットの主役。
#     OcclusionBakeCompare.kscene / UnwrapSplitCompare.kscene と同じ.kmodelを使う
#   ・鏡面の床。ドラゴンと壁を映す相手
#   ・市松模様の背景壁。レイトレーシングのヒット面がテクスチャを引けているかを見る
#
# 生成手順:
#   python Tools\generate_meshlet_stage.py
#   KurenaiPacker.exe Assets\Source\MeshletStage\MeshletStage.gltf ^
#     -o Assets\Packed\MeshletStage\MeshletStage.kmodel
#   KurenaiPacker.exe Assets\Source\ChineseDragon\dragon.obj ^
#     -o Assets\Packed\ChineseDragon\DragonPlain.kmodel
#
# 【床と壁を別モデルにしてある理由】ドラゴンはテクスチャを持たない3Dスキャンなので、
# ヒット面が単色でも「bindlessでテクスチャを引けていない」のか「もともと単色」なのかが
# 区別できない。模様のある面を1枚入れておくと、その1点だけで判別が付く。
#
# 確認手順:
#   1. ImGuiの「レンダリング」→「メッシュレット」で、メッシュレット数が0でないことを確認する
#      (0なら.kmodelが--no-meshletsで焼かれている。付けずに再パックすること)
#   2. 「メッシュレット描画を有効にする」をON/OFFして、見た目が変わらないことを確認する。
#      変わったらメッシュシェーダー側の頂点変換が頂点シェーダーとずれている。
#      「プロファイラ」パネルのGBufferパスの時間はONのほうが短くなるはず
#   3. 「メッシュレットを色分けして表示」をONにする。ドラゴンが数十頂点規模の塊に分かれて見える
#   4. 反射を「レイトレーシング (RT)」にすると、床に映るドラゴンも同じ色分けになる。
#      同じ塊が同じ色で映れば、描画とレイトレーシングが同一のジオメトリを見ている
#   5. 色分けを戻すと、床に映る背景壁に市松模様が出る。かつてRTのヒット面は
#      マテリアルの定数色しか使えなかったため、ここが単色ならbindlessが効いていない
#   6. DX11へ切り替えると、メッシュレットもRTも選べなくなり従来描画で動く

[Scene]
Name = Dragon (Meshlet / Bindless / Raytracing)
# 床の反射はレイトレーシングで見たいので、スクリーンスペース反射は既定で切っておく。
# 両方効いていると「反射が画面外で途切れるのはどちらの制約か」の切り分けができない
ScreenSpaceReflection = false

# 3Dスキャンの向きはカメラに背を向けているため、他のドラゴンのシーンと同じく180度回す
[Model]
Path = ChineseDragon/DragonPlain.kmodel
RotationEuler = 0.0, 180.0, 0.0

[Model]
Path = MeshletStage/MeshletStage.kmodel

# ドラゴンと、その足元に映る反射像の両方が視界に入る高さ。
# 低く構えるほど床の反射が広く映る(フレネルで斜入射ほど反射率が上がるため)
[Camera]
Position = 0.0, 0.55, -2.8
Yaw = 0.0
Pitch = -8.0

# 影の輪郭がメッシュレットの境目と紛れないよう、太陽は高めに置く
[Sun]
TimeOfDay = 10.5
Shadow = true

# ドラゴンの陰側が黒く潰れると色分けが読めなくなるため、補助光を1つ置く
[Light]
Type = Point
Position = -3.0, 3.0, -2.0
Color = 1.0, 0.95, 0.9
Intensity = 900.0
Range = 14.0
