# KurenaiEngine シーンファイル - メッシュ単位フラスタムカリングの検証(真下向き)
#
# 【何のためのシーンか】メッシュ単位フラスタムカリングを ON/OFF して絵が変わらないことを
# 確かめるための構図。docs/ImplementationHistory.md 52章の実測はこのシーンで取った。
#
# 【なぜ真下向きなのか】48章で入れたモデル単位カリングは、視錐台平面を行から作るバグを踏んだ。
# 正面付近ではそれらしい結果が出てカメラを振れば間引き数も動くため、Yawを振る対照実験は
# 素通りしてしまい、ほぼ真下(Pitch -85)を向けて初めて「100%間引かれている」と分かった。
# 振る軸が壊れている軸と違うと、対照実験は通ってしまう。
#
# 【なぜ空を入れないのか】既定視点のEmerald Squareは、設定を何も変えずに4秒あけて2枚撮るだけで
# 画素の6.7%が変わる(雲と植生のアニメーション)。この状態でON/OFFの差を測っても何も言えない。
# 真下を向けば空がほぼ入らず、実測でノイズ下限が厳密に0になる。
#
# 【なぜEmerald Squareなのか】1モデルに約220メッシュを持つので、モデル単位のカリングでは
# 1つも間引けない。したがってメッシュ単位の間引き数が非0なら、それはこの判定だけが出せる値になる。
#
# 出典・変換手順は EmeraldSquare.kscene を参照(同じ .kmodel を使う)。
#
# カメラは街区の中心の上空180mから俯角85度。Emerald SquareのAABBは
# X -115.1〜115.0 / Y -4.9〜108.3 / Z -115.1〜115.1(Day.kmodelのヘッダから実測)。

[Scene]
Name = Mesh Cull Test (Pitch -85)

[Model]
Path = EmeraldSquare/Day.kmodel

[Camera]
Position = 0.0, 180.0, 0.0
Yaw = 0.0
Pitch = -85.0

[Sun]
TimeOfDay = 12.0
Shadow = true
