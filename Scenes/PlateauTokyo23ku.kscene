# 【LOD2 地区が見える位置に置く】以前は高度900mから30km先を見る俯瞰にしていたが、
# それだと大気遠近で全面が白く飛び、LOD2 のテクスチャも LODDistance の外なので
# 一度も出ない。採用タイルのうち最も建物が高い 53393599(264.8m / X -19 / Z -1305)を、
# LODDistance(1500m)の内側から北東に見込む位置へ移した。
# 手前に LOD2 のテクスチャ付きの街、その奥に LOD1 の箱が地平まで続く絵になる。
# 【自動配置に任せられない】カメラを書かないとバウンズの20%内側へ置かれ、
# 33km四方のシーンでは建物の中に埋まる(BistroExterior.kscene と同じ理由)。
[Camera]
Position = -1500.0, 300.0, -2400.0
Yaw = 53.5
Pitch = -6.0

[Sun]
TimeOfDay = 10.0
AzimuthDegrees = 150.0
Shadow = true
