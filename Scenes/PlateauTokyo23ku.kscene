# KurenaiEngine シーンファイル - Project PLATEAU 東京都23区(全種)
#
# 東京23区の全域(約 33.0 km x 34.0 km)を、建築物・地形・道路・橋梁の4種で構成したもの。
#
#   建築物  671 タイル(3次メッシュ=約1km四方)。うち 26 タイルは LOD2 が整備されており、
#          Path=LOD2 / LODPath=LOD1 の2段LODにしてある(下記)
#   地形     14 タイル(2次メッシュ=約10km四方)
#   道路     14 タイル(同上)
#   橋梁     68 タイル(3次メッシュ)
#   [Model] 合計 767 件
#
# 出典: 国土交通省 Project PLATEAU「3D都市モデル(Project PLATEAU)東京都23区」
#       https://www.geospatial.jp/ckan/dataset/plateau-tokyo23ku
#       ライセンス: 公共データ利用規約(PDL1.0) / CC BY 4.0 互換。商用利用可・要出典表示。
#       著作権は各地方公共団体に帰属する。
#
# 【このファイルは機械生成されたもの】 Tools\plateau_scene.py が出力する。
# 取得から配布までは Tools\import_plateau.ps1 が一括で行う:
#   Tools\import_plateau.ps1
#   Sample3D.exe -scene PlateauTokyo23ku
#
# --- 変換コマンド ---
#   KurenaiPacker.exe <展開先>\<種別>\<メッシュコード>_*.fbx ^
#     -o Assets\Packed\Plateau\<種別>\<メッシュコード>.kmodel --origin -8096,0,-36118
#
# 【--origin は全種で同じ値】PLATEAU の FBX は EPSG:6677(平面直角座標系 第9系)の絶対座標で、
# 系原点から北へ最大52km離れている。頂点は float32 で、.kmodel の AABB もそのまま巨大になり、
# 遠クリップ面が桁で狂う。タイルごとに「自分のAABBの中心」で寄せると相対位置が壊れるため、
# 全種・全タイルで同じ値を引く。値は Tools\plateau_mesh.py origin が算出する。
#
# 【brid のファイル名に _6697 を名乗る個体がある】EPSG:6697 は緯度経度系だが、中身は
# 他と同じ平面直角座標のメートル値だった。全68件のAABBをメッシュコードから計算した
# 期待矩形と突き合わせて確認済み(Tools\plateau_mesh.py rect で再現できる)。
#
# --- シーンの規模と、そこから決まるもの ---
#   AABB  X -16903 〜 16095 / Y -11 〜 351 / Z -17881 〜 16117
#   大きさ 32998 x 361 x 33998 m / 対角 47380 m
#   遠クリップ面 farZ = max(100, 対角x4) = 189520 m

[Scene]
Name = PLATEAU 東京23区 (建築物LOD1/LOD2・地形・道路・橋梁)

# 【カスケードの分割範囲を打ち切る】farZ が 189520m のままだと第1カスケードが数kmを
# 2048x2048の1枚で覆うことになり、近景の影が事実上消える。
# 500m で打ち切ると第1カスケードは約31mを覆う(遠景の描画距離は farZ のまま変わらない)。
ShadowDistance = 500

# 【必ず指定する】未指定だとストリーミングが丸ごと無効になり、SceneLoader が
# 全 LOD 段を起動時に確保する ―― LOD2 の26タイルだけで約9GBになる。
# 指定するとエンジンは各インスタンスの「現在の LOD 段」だけを読むので、
# LOD2 は LODDistance の内側にあるタイルにしか載らない。
#
# 【10km にする根拠は大気遠近】以前はシーン対角(47380m)にしていた。
# 「距離で切ると遠景が途切れる」という判断だったが、そこまで見えていなかった。
# 透過率は exp(-消散係数 x 距離) で、既定の 0.00040 だと 5km で 13.5% /
# 10km で 1.8% / 20km で 0.03% まで落ちる。10km より遠いジオメトリは
# 載せてはいたが霞に埋もれて一度も見えていない。
#
# 対角から 10000m へ下げた実測(RTX 4070 Ti / DX12 / Release / 1280x720 /
# 初期カメラ)。地上の絵は152万画素で最大差1(量子化誤差)、実質1画素も変わらない:
#   常駐 767 -> 404 / VRAM 11,086 -> 6,926 MB(予算超過が解消) /
#   GPU待ち中央値 4.12 -> 0.00 ms / 最悪フレーム 60.50 -> 18.75 ms /
#   RT高速化構造の構築 49.4 -> 8.5 秒
#
# 【消散係数を変えたら測り直す】霞を薄くすると遠くまで見えるようになり、
# 10km で切ると本当に途切れる。根拠は docs/ImplementationDetail.md 60章。
#
# 【副作用: メッシュ単位フラスタムカリングが無効になる】SceneLoaderは
# MeshWorldBoundsList を「読み込み済みの実体」からしか作れず、ストリーミング時は
# 実体が無いまま構築が終わる。あとから読み込まれたぶんも作り直されないため、
# 描画側は保守側(間引かない)へ倒れる。実測でメッシュ単位は判定5964/間引き0(0.0%)。
# モデル単位は85.9%効いており、DX11/Release/1280x720 で 56 FPS 出ているので
# 実害は出ていないが、「メッシュ単位が0%なのはカリングの不具合ではない」と
# 分かるようにここへ書いておく。
StreamingDistance = 10000

# 【対角から自動決定させると速すぎる】対角47kmだと自動値は600m/s級になり、
# LOD の切り替わりを目で追えない。
CameraSpeed = 150

# --- 建築物 -------------------------------------------------------------
# LOD2 を採用した 26 タイルは2段LOD。1500m を超えると LOD1(箱)へ落ちる。
# 距離は「カメラ位置からインスタンスのAABBの最近接点まで」で測られるので、
# 自分がいるタイルは0m、隣接タイルは約1.1kmになる。
#
# 【LOD2 があっても使っていないタイルが 54 件ある】PLATEAU の LOD2 はタイル全体が
# 整備されているとは限らず、一部の建物だけのものが混ざる。それを Path(=LOD0) に据えると
# 近づくほど建物が消えるので、足切りしてある。
# 判定は「LOD1 の頂点が占める50m格子のセルを LOD2 がどれだけ覆うか」で、しきい値 0.95。
# (Tools\plateau_lod2_coverage.py で再現できる。AABBの被覆率やジオメトリ量の比では
#  測れない ―― 建物が2棟でも対角にあればAABBは満杯になり、LOD2は1棟あたりの頂点が
#  桁で多いのでジオメトリ量は一部整備でもLOD1を超える)
# 除外したタイルと被覆率:
#   53392650 被覆 0.476
#   53392660 被覆 0.457
#   53392670 被覆 0.228
#   53393549 被覆 0.091
