# 街区の広がりが分かる俯瞰。西新宿(--origin適用後で X -5123〜-3939 / Z 946〜1996)を
# 北東方向に見込む位置に置いている。
# 【自動配置に任せられない】カメラを書かないとバウンズの20%内側へ置かれ、
# 33km四方のシーンでは建物の中に埋まる(BistroExterior.kscene と同じ理由)。
[Camera]
Position = -6500.0, 900.0, -800.0
Yaw = 35.0
Pitch = -22.0

[Sun]
TimeOfDay = 10.0
AzimuthDegrees = 150.0
Shadow = true
