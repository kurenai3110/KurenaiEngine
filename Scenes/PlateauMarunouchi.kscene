# KurenaiEngine シーンファイル - Project PLATEAU 東京駅・丸の内(建築物 LOD2)
#
# 3次メッシュ 53394600 / 53394601 の建築物 LOD2 と、同じ範囲の橋梁、および
# それを含む2次メッシュ 533946 の地形・道路。LOD2 なので建物にテクスチャが付く
# (LOD1 はマテリアルが DefaultMaterial 1件だけで、テクスチャを構造的に持てない)。
#
# 出典: 国土交通省 Project PLATEAU「3D都市モデル(Project PLATEAU)東京都23区」
#       https://www.geospatial.jp/ckan/dataset/plateau-tokyo23ku
#       ライセンス: 公共データ利用規約(PDL1.0) / CC BY 4.0 互換。商用利用可・要出典表示。
#       著作権は各地方公共団体に帰属する。
#
# --- 変換コマンド ---
#   KurenaiPacker.exe <展開先>\bldg\lod2\<メッシュコード>_bldg_6677.fbx ^
#     -o Assets\Packed\Plateau\BldgLod2\<メッシュコード>.kmodel --origin -8096,0,-36118
#   (dem/tran/brid も出力先を Dem/ Tran/ Brid/ に変えるだけで同じ)
#
# 【--origin は全種で同じ値】PlateauTokyo23ku.kscene と揃えてある。671タイルの中心から
# 求めた共通オフセットで、種別ごとに変えるとタイル同士の相対位置が壊れる。
# 揃えてあるので、このシーンの座標は23区シーンの座標とそのまま対応する。
#
# 【brid の座標系は実AABBで確認済み】ファイル名に _6697 を名乗る個体が別にあるが、
# ここで使う2件は bldg と同じ平面直角座標のメートル値だった
# (bldg 53394600 が X 491〜1707 / Z -873〜97、brid 53394600 が X 581〜1695 / Z -968〜-55)。
#
# --- 実測(パック後) ---
#   bldg 53394600  メッシュ 1180 / 頂点 289,782 / テクスチャ 1,179
#   bldg 53394601  メッシュ 2202 / 頂点 592,530 / テクスチャ 2,201
#   brid 53394600  メッシュ   11 / 頂点   4,988 / テクスチャ    10
#   brid 53394601  メッシュ   23 / 頂点  17,561 / テクスチャ    22
#   dem  533946    メッシュ    1 / 頂点 673,956 / テクスチャ     0
#   tran 533946    メッシュ    1 / 頂点1,583,202 / テクスチャ    0
#   計 3,418メッシュ / 3,162,019頂点 / テクスチャ 3,412枚

[Scene]
Name = PLATEAU 東京駅・丸の内 (建築物 LOD2)

# 【dem と tran がシーンを10km四方へ広げる】この2つは6桁=2次メッシュで、
# bldg/brid の3次メッシュ(約1km四方)とは分割単位が違う。丸の内だけに切り出せないため、
# シーンAABBの対角は約16.5kmになる。放置すると遠クリップ面(farZ = max(100, 対角x4))が
# 66km級まで伸び、カスケードの分割範囲がそのまま伸びて近景の影が事実上消える。
# ここで手前に打ち切って近景の影の密度を戻す(23区シーンと同じ500m)。
ShadowDistance = 500

# 【対角から自動決定させると速すぎる】上と同じ理由でシーン対角が16.5kmになるため、
# 自動値は約240 m/s(Shiftで960 m/s)になる。見たいのは丸の内の2.3km四方なので、
# 街区を横切るのに十数秒で済む速度を明示する。
CameraSpeed = 30

[Model]
Path = Plateau/BldgLod2/53394600.kmodel

[Model]
Path = Plateau/BldgLod2/53394601.kmodel

[Model]
Path = Plateau/Brid/53394600.kmodel

[Model]
Path = Plateau/Brid/53394601.kmodel

[Model]
Path = Plateau/Dem/533946.kmodel

[Model]
Path = Plateau/Tran/533946.kmodel

# 【カメラはジオメトリの占有から決めた】.kgeom の頂点を100m格子で数え、建物が
# 密なのが X 1550〜2750 / Z -750〜-50、最高部が X 2150 / Z -550 の147.8mだと分かった。
# その手前(西側)の疎なところから東を向き、ビル群の壁面を正面に入れる。
# 【建物の中に入らない高さにする】上位のマスを除けば最高70m前後なので、120mなら
# 屋上より上を通る。自動配置(バウンズを20%内側)だと建物の内部に入る。
[Camera]
Position = 1100.0, 120.0, -400.0
Yaw = 90.0
Pitch = -12.0

[Sun]
TimeOfDay = 10.0
Shadow = true
