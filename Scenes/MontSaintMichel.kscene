# KurenaiEngine シーンファイル - モン・サン=ミシェル風景検証(P1: シーン一式の手続き生成)
#
# 実写のモン・サン=ミシェル(干潟の鏡面反射に城が映り込む構図)に寄せた検証用シーン。
# 3つのモデルはすべて Tools/generate_*.py の手続き生成スクリプトが吐く
# (Assets/Source/MontSaintMichelStudy/ → KurenaiPacker.exeで Assets/Packed/MontSaintMichelStudy/ へ変換):
#   TidalFlat.kmodel … Tools/generate_tidal_flat.py (干潟、6000m四方)
#   Island.kmodel    … Tools/generate_msm_proxy.py  (岩・城壁・修道院・尖塔のシルエットプロキシ)
#   Water.kmodel     … Tools/generate_water_plane.py (水面、4000m四方)
#
# P2(水面マテリアル基盤)でWaterモデルに[Model]Water=trueと[Water]セクションを追加した。
# Waterインスタンスは通常のG-BufferパイプラインではなくWater.hlsl専用PSOで描画され、
# G-BufferのMaterial.aへ水面のマテリアルID(kMaterialIDWater)が書き込まれる。
# 反射(SSR統合)はまだ行わない(それはP4)。
#
# --- 座標系の約束 ---
# 島(Island)の底面中心をワールド原点(0,0,0)とする(1単位=1メートル)。将来、実物の
# モン・サン=ミシェルのモデルへ差し替える際は、下の[Model]Pathを1行差し替えるだけで済む。
#
# --- なぜTidalFlat/WaterだけZ=-800なのか ---
# TidalFlat・Waterはどちらも自分自身のローカル原点を中心にメッシュを生成している
# (Tools/generate_tidal_flat.py、Tools/generate_water_plane.py)。干潟の「エプロン」
# (島の足元を持ち上げる地形)はgenerate_tidal_flat.py内でローカル座標(0, 800)を中心に
# 作られており、ここへTranslation.z=-800を与えることでワールド原点(島の位置)と
# ちょうど一致する(詳細はgenerate_tidal_flat.pyのモジュールdocstring参照)。Waterは
# TidalFlatと同じZオフセットを与えて位置関係を保ち、水面が干潟の上に正しく重なるようにしている。
[Scene]
Name = Mont Saint-Michel Study
# 干潟の鏡面反射はこの構図の主役なので、このシーンでだけ反射を有効にする。
# 水面の反射(平面反射の鏡像 + 解析空へのフォールバック、P4/P6)はSSRパスの中に実装されており、
# エンジンの既定はSSR無効(画面端で反射が途切れる破綻が目立つため)。ここで有効にしないと
# 水面が反射を1つも映さない真っ平らな面になる
ScreenSpaceReflection = true
# 屋外の風景なのでトーンマップはACESにする。エンジンの既定AgXはハイライトを色相保持のまま
# 白へ脱色するため赤い内観には強いが、空のような広い面では彩度を落とす
# (実測: 空の最も青い画素の B/R が 1.53 → 1.34)
Tonemap = ACES
# 黒の締め(ブラックポイント)。トーンマップ後の表示リニア値からこの値を引き、
# 残りを[0,1]へ伸ばし直す。実カメラのトーンカーブが持つ処理に相当する。0で恒等。
# 【なぜ要るか】屋外の遠景では大気遠近が最暗部へ空の輝度を一定量だけ加算する。
# 600m先・視程78kmでも空の3%が乗り、空は深い影の50倍ほど明るいので、画面上の
# 最暗値が輝度31前後で頭打ちになる。参考写真の同じ構図は6まで落ちており(黒潰れでは
# なく4〜30に滑らかに分布していることを確認済み)、その差は凹凸では埋まらない
# (窓・軒・煙突を足しても最暗値は32から動かなかった)。
# 霞を非物理的な視程まで薄めるのではなく、カメラ側の処理としてここで締める。値は下記の測定で決める
TonemapBlackPoint = 0.0
# 空の彩度(物理量ではないアート指定)。1.0で物理モデルの色度そのまま。
#
# P13bまではPreethamの淡さを埋めるために1.9まで上げていた。P14bで空をHillaire (2020)へ
# 置き換え、Rayleigh散乱のλ^-4を物理から出せるようになったぶんここを下げられた。
#
# 【なぜ1.0まで戻せないのか】参考写真の目標値(B/R 中央1.67 / 90%点3.27 / 98%点4.84)は
# **画面のsRGB値で測ったもの**である。98%点の画素(17,109,226)を線形へ戻すとR:Bは約1:300で、
# Rayleigh散乱の物理的な上限(5.70)を50倍以上超えている。つまりあの写真は撮影後に彩度を
# 大きく上げてある。物理モデルはどんな露出でもこの数字には到達できない。
#
# 実測(仰角14〜21度の帯、明るさ80以上の画素。露出は下のEV100=15.0で固定):
#   彩度1.25 … B/R中央1.54 / 90%点2.73     彩度1.30 … 1.59 / 3.07
#   彩度1.35 … 1.64 / 3.56
# 写真(中央1.67 / 90%点3.27)を挟むのがこの範囲なので、両方の近くを通る1.32を採る。
# 【上限は色域】1.5を超えると最も青い画素の赤が0まで潰れる(実測: 彩度1.6で対象画素の23%がR<=2)
SkySaturation = 1.32
# シーン全体の露出(EV100)。値が大きいほど暗く写る(写真のEVと同じ向き)。
#
# 参考写真の空の帯の輝度(255段階)は 平均173.6 / 中央172 / 90%点220、B/Rは中央1.67 / 90%点3.27。
# 露出を振った実測(彩度1.35固定):
#   EV100 14.25 … 平均204 中央207 | B/R中央1.38
#   EV100 14.75 … 平均188 中央189 | B/R中央1.54
#   EV100 15.00 … 平均178 中央179 | B/R中央1.64   ← 採用
#   EV100 15.25 … 平均169 中央169 | B/R中央1.75
#
# 【この値はエンジンの既定値と同じ】つまりこのシーンでは露出を動かす必要が無かった。
# 明示的に書いてあるのは、シーンが自分の露出を持つことをファイル上で読めるようにするため
# (エンジンの既定値が将来変わってもこのシーンの見た目が動かない)。
# なお一度は14.75を採用したが、それはスクリーンショットにImGuiのツールチップが写り込んだ
# 状態で輝度を測っていた(測定領域の中に暗い帯が入り、中央値が18ほど低く出ていた)ため
Exposure = 15.0

[Model]
Path = MontSaintMichelStudy/TidalFlat.kmodel
Translation = 0, 0, -800

[Model]
Path = MontSaintMichelStudy/Island.kmodel
Translation = 0, 0, 0

# 干潟のノイズ振幅(±0.5m程度)に対して0.15mだけ高くする。干潟の低い場所(谷)は水没して
# 水路になり、高い場所(尾根)は水面から顔を出して砂州になる。写真と同じ「干潟の一部が
# 水を被り、一部が乾いている」構造を再現するための値
[Model]
Path = MontSaintMichelStudy/Water.kmodel
Translation = 0, 0.15, -800
Water = true

# 水面(P2: 水面マテリアル基盤)。NormalMapはAssetsルートからの相対パス([Scene]Skyboxと同じ規則)。
# WaveScale/WaveSpeed/WaveStrengthはP1の時点でこのファイルのコメントに残していた暫定値をそのまま使う
[Water]
NormalMap = MontSaintMichelStudy/WaterNormal.png
WaveScale = 12.0
WaveSpeed = 0.03
WaveStrength = 0.25

# カメラは島の手前(-Z側)、水面のすぐ上に置く。Yaw=0で+Z方向を向く
# (Source/Library/Core/Camera.cpp Camera::GetForward: forward = (cos(pitch)sin(yaw), sin(pitch), cos(pitch)cos(yaw))。
#  yaw=0, pitch=0を代入すると forward=(0,0,1) になるため、Yaw=0がそのまま+Z方向)。
# Pitchは水平よりわずかに上(2度)にして、y=165付近まで伸びる尖塔の先端が画角に収まるようにしてある
[Camera]
Position = 0, 1.6, -600
Yaw = 0
Pitch = 2

# 午前(TimeOfDay=9.0)・方位角270度。カメラのある南側から島を照らす設定。
#
# 【修正・旧値では島の正面が影になっていた】旧値は TimeOfDay=11.0 / AzimuthDegrees=45.0
# だったが、これは実機で島全体が暗く沈む原因だった。エンジンの太陽は
# 「日の出方向 → 天頂 → 日の入り方向」の半円を描き(Source側のComputeSunLighting)、
# 時角は hourAngle = (TimeOfDay/24)*2π - π/2、AzimuthDegreesは日の出の水平方向を表す
# (X=0度, +Z=90度)。
# 旧値を代入すると太陽の向きは (0.183, 0.966, 0.183) となり、ほぼ真上かつわずかに北寄り。
# カメラ側を向く南向きの壁(法線(0,0,-1))との内積が -0.183 で**負**になり、
# 実機カメラから見える面がすべて影に入っていた。
# TimeOfDay=9.0 で仰角を下げ、AzimuthDegrees=270 で日の出方向を -Z(南)側に取ることで、
# 参考写真と同じく南面が順光になる。
#
# 【修正・順光にしすぎて石の造形が消えていた】270度だと太陽の向きは (0, 0.707, -0.707)、
# つまり真南45度でカメラの真後ろになり、南面が完全な順光になって影が一切出ない。
# 参考写真の修道院の壁を拡大すると、見えている変動の主成分は石の色ではなく
# 控え壁が落とす深い縦の影で、光は左(西)から来ている。
# 材質IDの地図で材質ごとに画素を選び、最終画の輝度の変動係数を測ると:
#   方位   島全体CV  石積CV  集落壁CV  平均輝度
#   270     0.254    0.137   0.146    135.1
#   250     0.262    0.157   0.129    131.9
#   230     0.291    0.205   0.163    123.6
#   210     0.342    0.260   0.225    110.8
#   参考写真 0.607     -       -        80.5
# 【210度は西へ振りすぎだった】210度にすると、南東を向く集落の東半分の正面が影に入る。
# 参考写真ではそこは日向で、「東の家の壁の明るさ ÷ 島全体の平均」は1.13ある。
#   方位   島CV   石積CV  東の壁/平均
#   210   0.412  0.308   0.76
#   225   0.358  0.250   0.84   ← 採用(真南西)
#   240   0.319  0.195   0.95
#   255   0.297  0.152   1.02
#   270   0.254  0.137    -
# 2つの指標は真正面から相反する。写真が両方を満たすのは、写真の陰影が「面を光から
# 背ける」ことではなく窓・控え壁・軒といった局所の凹凸から出ているため。
# 方位は写真の光の向き(真南西)に合わせ、コントラストは開口と分節の側で作る。
# 225度の太陽の向きは (-0.500, 0.707, -0.500)。
#
# 【以前「方位は効かない」と報告したのは誤り】当時は霞が2倍濃く(視程19.6km。
# 空の輝度の11%が一様に足されて影が埋まっていた)、集落も斜面全体を覆う配置のままで、
# しかも集落の帯の輝度分布だけを見ていた。条件が変わったので測り直した結果を採る。
[Sun]
TimeOfDay = 9.0
AzimuthDegrees = 225.0

# 【マージ時の注意】master(landscape-water-sky由来)はここを 11.0 / 45.0 のまま持っており、
# 下の[Cloud]・[Fog]と[Scene]の露出はその太陽の下で測って決められている。
# こちらの 9.0 / 270.0 は上のコメントの理由(参考写真と同じく南面を順光にする)で
# 意図的に変えた値なので残すが、**太陽の位置が違えば空の輝度も変わる**。
# 雲・霞・露出の数値を次に詰めるときは、この太陽の下で測り直すこと

# 雲(P10)。指定したキーだけエンジンの設定を上書きする。
#
# 【いまの値はすべてエンジンの既定値と同じ。つまりこのシーンの見た目は何も変えていない】
# 明示的に書いてあるのは、次にここを詰めるときの起点を残すためと、ホットリロードで
# 振れるようにするため(このセクションが無いとエンジンを再ビルドしないと雲を動かせない)。
#
# 【写真との差は「大きさ」でも「濃さ」でもなかった】どちらも実測で否定した:
#  ・大きさ … 島の幅を物差しにすると(画角の違う2枚を比べるにはこれしかない)、雲の塊は
#             写真と同程度。被覆率も24.4%対26.2%でほぼ同じ
#  ・濃さ   … Densityを上げても雲は明るくならない。8→100(有効な範囲の上限)で雲画素の
#             中央輝度はむしろ202→162と下がる。自己影が増えるためで、向きが逆
#             【この点は一度誤って記録した】以前ここに「8→120(15倍)でも99%点は223→225」と
#             書いていたが、Densityの有効範囲は0〜100でありその120は読み込み時に弾かれて
#             いた(ログに「Densityの値が範囲外です」が出ていた)。適用されていない値で
#             測っていたことになる
#
# 【本当の原因は霞だった】雲の明るさを削っている項を1つずつ止めて測ると、
# 「雲の90%点 − 空の中央値」(255段階)は
#   現状 53.6 / 横方向の自己影を止める 54.8 / 縦方向の勾配を止める 57.2 /
#   **雲への大気遠近を止める 78.2** (参考写真は 68.6)
# となり、大気遠近がほぼ単独で効いていた。雲底1,500mの層は仰角20度の方向で4.4km先にあり、
# 以前の消散係数0.0004(視程9.8km)ではそこまでの透過率が0.40しかない——雲のコントラストの
# 6割が目に届く前に空の色へ溶けていた。対処は下の[Fog]セクション
[Cloud]
Coverage = 0.40
Altitude = 1500.0
Thickness = 400.0
Density = 8.0
CellSize = 1000.0
CirrusCoverage = 0.5

# 大気遠近(霞)。指定したキーだけエンジンの設定を上書きする。
#
# 【視程で決める】消散係数は気象学的視程Vと Koschmieder の V = 3.912 / 消散係数 で
# 結び付く。エンジンの既定値0.0004は視程9.8km相当で、「晴れているが遠景が霞む日」に当たる。
# 参考写真は遠くの海岸線まで見えている澄んだ日なので、このシーンは視程約20kmを採る。
#
# 【この値が主に効くのは遠景ではなく雲】上の[Cloud]のコメントに書いたとおり、消散係数は
# 雲がどれだけ空から浮き上がって見えるかを一手に決める。視程を振った実測
# (雲の90%点 / 雲の90%点 − 空の中央値、255段階。参考写真は 243.1 / 68.6):
#   視程 9.8km … 214.5 / 53.6      視程 19.6km … 226.6 / 66.6
#   視程 39.1km … 232.7 / 72.9     視程 78.2km … 235.0 / 75.2   ← 元は19.6kmを採用していた
#
# 【島側で測り直して39.1kmへ上げた】19.6kmは雲のコントラストだけを見て選ばれていたが、
# 同じ霞が島(カメラから600m)にも掛かる。視程19.6kmの透過率は600mで0.887なので、
# **空の輝度の11%が島全体へ一様に足される**。写真の影は空の0.4%の明るさしかないため、
# これで影が完全に埋まる。実測(集落の帯、参考写真は p95/p5=49.7倍・暗部30%・R/G=1.020):
#   視程 19.6km … p95/p5= 4.1倍 暗部 0% R/G=0.815   ← 暗い画素が1つも無い。青被りも最大
#   視程 39.1km … p95/p5= 6.2倍 暗部 2% R/G=0.917   ← 採用
#   視程 78.2km … p95/p5= 8.3倍 暗部 5% R/G=0.985
#   視程 ほぼ無限 … p95/p5=12.6倍 暗部 9% R/G=1.071
# 青被り(集落のB/Gが写真0.998に対し1.100)も、素材ではなく足されている霞の色だった。
# 39.1kmは上の雲の表でも写真を挟む範囲に入っており、雲の絶対輝度(232.7 対 写真243.1)は
# むしろ19.6kmより近い。雲側の根拠を壊さずに島の青被りをほぼ解消できる点でここを採る。
#
# なお霞を完全に消しても暗部は9%止まりで写真の30%には届かない。残りは
# モデルに窓・軒・路地といった小さな凹凸が無いことによるもので、この値では埋まらない。
# 太陽の方位と環境光も1つずつ止めて測ったが、どちらも p95/p5 をほとんど動かさなかった
# 【修正・影の底がまだ霞で埋まっていた】材質IDの地図で島の画素を選んで最終画の輝度を
# 測ると、実機には輝度47より暗い画素が1つも無かった(参考写真は p1=6 / p5=17、
# 島の13%が「平均の35%未満」の暗部)。原因を項ごとに止めて測った:
#   変えた項            島平均  CV     暗部   p1  空p25 雲p90
#   霞0.0001(旧)       111.1  0.336   0.0%   47   217   224
#   環境光を0.6へ        113.6  0.324   0.0%   49    -     -
#   環境光を0.0へ        102.5  0.387   0.1%   42    -     -    ← 環境光ではない
#   露出15.7             82.2  0.419   0.2%   31   195   203
#   露出16.1(空が一致)   67.8  0.468   1.2%   24   179   188   ← 島も雲も暗くなりすぎ
#   霞0.00005(視程78km) 102.1  0.408   3.1%   31   218   227   ← 採用
#   霞0.00002(視程196km) 96.0  0.466   6.3%   18   218   228
#   参考写真             80.5  0.607  13.0%    6   181   243
# 環境光をゼロにしてもp1は47→42しか下がらず、霞を薄めると47→31→18まで落ちる。
# 高度指数の霞(HeightFog.hlsli)は視程39kmでも600m先で空の輝度の5.8%を加算し、
# 空は深い影の50倍ほど明るいので、この5.8%だけで最暗部が数倍になる。
#
# 【なぜ0.00002まで下げないか】視程196kmは大気として非物理的で、色味も写真から離れる
# (岩のB/G 写真0.949に対し 0.00005で0.913・0.00002で0.891、樹冠のB/Gは0.881→0.720)。
# 視程78kmはlandscape-water-skyが雲のために測った表にも入っている範囲の上端なのでここで
# 止め、残る暗部は開口(集落の窓)と分節(修道院の控え壁)で本物の影として足す
[Fog]
Density = 0.00005
