# KurenaiEngine シーンファイル - ドローンショー
#
# 夜の干潟の上空を1500機の発光ドローンが編隊飛行し、6つの図形へ次々と変形する。
# 水面には編隊がそのまま映り込む(平面反射パスへ機体を描き足している)。
#
# --- 舞台の使い回しについて ---
# 地形・水面はモン・サン=ミシェル検証シーン(MontSaintMichel.kscene)のモデルを
# そのまま使う。手続き生成された干潟・島・水面の3点セットで、
# 「広い水面と、その向こうの低い岩山のシルエット」というこのショーに必要な条件を
# すでに満たしているため、新しいモデルを作る必要がない。
#   TidalFlat.kmodel … 干潟(6000m四方)
#   Island.kmodel    … 岩山のシルエット(最高点はy=165m付近)
#   Water.kmodel     … 水面(4000m四方)
# 座標の約束(島の底面中心が原点、TidalFlat/WaterのZ=-800)もそちらに合わせてある。
# 詳しくは Scenes/MontSaintMichel.kscene のコメントを参照。

[Scene]
Name = Drone Show
# 水面に編隊を映すために必須。エンジンの既定はSSR無効で、有効にしないと水面が
# 何も映さない真っ平らな面になる。平面反射(m_PlanarReflectionColor)はSSRパスの中で
# 水面へ合成されるため、このフラグは平面反射の映り込みごと止めてしまう
ScreenSpaceReflection = true
# 夜景で光源が点在する構図なのでACES。エンジン既定のAgXはハイライトを白へ脱色するため、
# 機体の色(赤・青・緑と鮮やかに切り替わるのがショーの見どころ)が芯から白く抜けてしまう
Tonemap = ACES
# 【夜の露出】値が大きいほど暗く写る(写真のEVと同じ向き)。
# 実際のドローンショーの写真は「LEDが主役で、地上と空は沈んだ背景」という露出で撮られる。
# 月明かりの風景そのものに露出を合わせる(EV100で-2〜-4付近)と機体が完全に白飛びするため、
# 機体側に寄せた値を採る。地形が黒く沈むのは意図した結果であって露出の失敗ではない。
#
# 【露出で背景を決め、機体の芯は頭打ちになることを前提にする】
# 実測(編隊領域の画素値、sRGB 0-255):
#   Brightness=45 / Exposure=2.0 … 最大153
#   Brightness=400 / Exposure=2.0 … 最大153 (9倍にしても1段も上がらない)
#   Brightness=45 / Exposure=0.5 … 最大153、ただし画面全体の平均は11→26へ上がる
# つまり機体の芯はどちらのつまみでも動かず、約38,000画素が153に張り付く。
# 一方で露出は背景(空・水面・島)には効くので、ここは「背景をどこまで見せるか」で決める。
# 0.5だと夜空が濃紺として残り、水面のグラデーションと島のシルエットが読める。
#
# 【頭打ちの原因は未特定】TAA(既定で無効)・バッファ形式(いずれもR16G16B16A16_Float)・
# 撮影経路(昼のシーンでは198まで出る)は切り分け済みでどれも該当しない。
# 見た目には影響が小さいためここでは追っていない
Exposure = 0.5

[Model]
Path = MontSaintMichelStudy/TidalFlat.kmodel
Translation = 0, 0, -800

[Model]
Path = MontSaintMichelStudy/Island.kmodel
Translation = 0, 0, 0

[Model]
Path = MontSaintMichelStudy/Water.kmodel
Translation = 0, 0.15, -800
Water = true

[Water]
NormalMap = MontSaintMichelStudy/WaterNormal.png
# 波を穏やかにする。MontSaintMichelの既定(WaveStrength=0.25)のままだと法線の乱れで
# 反射像が砕けてしまい、編隊の形が水面で読み取れなくなる。凪いだ夜の水面にする
WaveScale = 18.0
WaveSpeed = 0.02
WaveStrength = 0.08

# 水面の上、干潟の沖からショーを見上げる構図。
# Yaw=0で+Z方向(島のある向き)を向く(Camera::GetForwardの定義。MontSaintMichel.ksceneのコメント参照)。
#
# 【カメラを水面から30m上げてある理由】平面反射で映る像は、視点が水面に近いほど
# 水平線際の細い帯に圧縮される(視点高さ2mだと編隊の反射がほぼ水平線に潰れる)。
# 30mまで上げると反射像が手前へ広がり、編隊の形が水面でも読める
[Camera]
Position = 0, 30, -1200
Yaw = 0
Pitch = 5

# 夜。太陽が地平線下(21.5時)に沈むと、平行光の枠がエンジン側で自動的に月へ切り替わる
# (KurenaiEngine3D.cpp の ComputeSunLighting。月の位置は時刻に連動せず既定の向きのまま)
[Sun]
TimeOfDay = 21.5
AzimuthDegrees = 45.0

# 雲は薄くする。被覆率を上げると編隊と星の両方を覆い隠してしまう
[Cloud]
Coverage = 0.15
Altitude = 2200.0
CirrusCoverage = 0.2

# 澄んだ夜。消散係数0.0002は気象学的視程で約20km相当(Koschmieder V = 3.912 / 消散係数)。
# 濃くすると1km先の編隊のコントラストが霞に溶ける
[Fog]
Density = 0.0002

# ブルーム。**エンジンの既定は無効**なので、ここで有効にしないと機体に光芒が出ない
# (機体の描画パスは加算合成でHDRを書くだけで、滲みは一切作らずブルームに任せている)。
# Strengthはトーンマップ内で元の色とブルームをlerpする比率
[Bloom]
Enabled = true
# 【Strengthを上げすぎないこと】トーンマップはブルームを「加算」ではなく元の色との
# lerpで合成する(Tonemap.hlsl)。点光源のようにピラミッドへ広く薄く散る対象では、
# 比率を上げるほど芯が暗くなるばかりで滲みは増えない。
# 実測(画面全体の平均輝度): Strength=0.5で5.90、ブルーム無効で12.13 ―― 半分以下に暗くなっていた
Strength = 0.15
Threshold = 1.0

# 星空
[Stars]
Enabled = true

# ドローンショー本体。
#
# 【編隊の位置】島(原点)の少し奥(Z=+100)の上空200mへ置く。カメラからは約1.3km先で、
# 仰角にして約9度——島のシルエット(仰角6度付近)のすぐ上に浮かぶ。
# Scale=140なので編隊は直径280m程度に広がり、画面の高さの1/3ほどを占める。
#
# 【水面より十分高く保つこと】平面反射パスは水面より下の機体をクリップ平面で落とす。
# Center.y - Scale が負になる配置にすると編隊の下半分が反射から欠ける
[DroneShow]
Enabled = true
Count = 1500
Center = 0, 200, 100
Scale = 140.0
# 【半径は機体の大きさではなく「光の見かけの大きさ」】ドローン本体は数十cmだが、
# 見えているのはLEDの光そのもので、大気の散乱とレンズのにじみで実際より大きく広がる。
# 1.3km先で半径1.5mだと画面上1画素強にしかならず、編隊が砂粒の集まりにしか見えない
Radius = 4.0
# 【明るさの決め方】芯が白飛びしない上限を採る。加算合成のあとACESを通るので、
# 上げすぎると色相を保ったまま白へ脱色し、機体の色(ショーの見どころ)が分からなくなる。
# 実測: 60は芯が完全に白、4.0は色は出るが暗すぎた
Brightness = 45.0
HoldSeconds = 6.0
MorphSeconds = 4.0
Speed = 1.0
