[Light]
Type = Point
Position = 0.53, 2.55, -0.33
Color = 1.00, 0.70, 0.42
Intensity = 800.0
Range = 7.0
CastShadow = false

[Light]
Type = Point
Position = -0.73, 2.55, 2.73
Color = 1.00, 0.70, 0.42
Intensity = 800.0
Range = 7.0
CastShadow = false

[Light]
Type = Point
Position = 7.57, 2.47, 4.43
Color = 1.00, 0.70, 0.42
Intensity = 800.0
Range = 7.0
CastShadow = false

[Light]
Type = Point
Position = 0.72, 2.55, 5.40
Color = 1.00, 0.70, 0.42
Intensity = 800.0
Range = 7.0
CastShadow = false

[Light]
Type = Point
Position = 2.14, 2.55, 8.00
Color = 1.00, 0.70, 0.42
Intensity = 800.0
Range = 7.0
CastShadow = false

# ------------------------------------------------------------------------------------------
# 反射プローブ(3個)
#
# この部屋は世界座標に対して回転している。垂直面の法線の向きを集計すると 62.5度 と 152.5度 の
# ちょうど90度差の二峰になり、部屋の軸は世界XZで -27.5度 と +62.5度 を向いていることが分かる。
# ReflectionProbe.hlsli の WorldToProbeLocal は world→local が +Yaw 回転なので、箱のローカルX軸は
# 世界の -Yaw 方向を指す。したがって壁に合わせるには Yaw = 27.5 が正しい(-27.5 ではない)。
#
# 部屋の形は、この回転フレーム(u = -27.5度方向, w = +62.5度方向)へ射影するとL字になる:
#   メインの部屋 : u∈[-2.45, 10.65]  w∈[0, 9]
#   奥の間       : u∈[-2.40,  3.00]  w∈[9, 14.2]
#   床 y=0.40 / 天井 y=4.20
# メインをカウンター側と客席側の2つに割り、奥の間を加えた3個構成にしている。
#
# 箱の張り方(ProbeTest.ksceneと同じ規約):
#   ・実際の壁・床・天井と重なる面だけ BlendDistance ぶん外側へ出す。境界で重みが0になるため、
#     壁面ちょうどに面を置くと壁自体が空のIBLへ薄まってしまう。
#     y は床0.40/天井4.20に対して箱を y∈[-0.50, 5.50] としてあり、0.9内側でちょうど重み1.0に達する
#   ・プローブ同士の継ぎ目は外へ出さない。カウンター側↔客席側はu方向に3.0、
#     奥の間↔メインはw方向に2.0の重なりがあり、どちらもBlendDistance(0.9)の2倍以上ある
#
# Position は箱の中心であると同時にキャプチャ位置でもある。y=2.50 は椅子の背(最大2.48)より上、
# 吊り下げランプの下端(2.95)より下に取ってあり、キャプチャ点がジオメトリに埋まらない
# ------------------------------------------------------------------------------------------

[ReflectionProbe]
Name = Counter Side
Position = 7.88, 2.50, 0.46
Shape = Box
BoxExtents = 4.78, 3.00, 4.95
Yaw = 27.5
BlendDistance = 0.9

[ReflectionProbe]
Name = Dining Side
Position = 2.60, 2.50, 3.21
Shape = Box
BoxExtents = 4.18, 3.00, 4.95
Yaw = 27.5
BlendDistance = 0.9

[ReflectionProbe]
Name = Back Room
Position = 5.37, 2.50, 9.66
Shape = Box
BoxExtents = 3.60, 3.00, 4.05
Yaw = 27.5
BlendDistance = 0.9
