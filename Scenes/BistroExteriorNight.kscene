# KurenaiEngine シーンファイル - Bistro (McGuire) 屋外の夜景
#
# Tools/extract_bistro_lights.py が生成する(手で編集しない)。
# 灯の位置・色・光源半径はすべて Assets/Packed/BistroMcGuire/Exterior.kmodel と
# Exterior.kgeom を直接読んで求めた実測値で、目分量の数値は1つも入っていない。
#
# --- 何のためのシーンか ---
# MegaLights の主張は「影付きのローカルライトを、灯数に依存しない固定費で出せる」
# (docs/ImplementationDetail.md 61.7e.5)。ところが従来の検証シーン(LightScale系)は
# 床と壁と球4個しかなく、影を落とす相手がいなかった。このシーンは実物の街路に
# 107 灯を置き、多数の影が重なる様子そのものを見せる。
#
# 起動:
#   Sample3D.exe -scene BistroExteriorNight -dx12 -megalights 2 -autoexposure 0
# MegaLights は DX12 + DXR Tier 1.1 が必須で、既定は無効。-dx12 を忘れると
# 「シーンは出るが MegaLights は走っていない」状態になる(差分ゼロを合格と誤読しやすい)。
#
# --- 灯の内訳(すべて三角形の連結成分から導出) ---
#   街灯                        28 灯  (Streetlight_Support_Bulb)
#   ストリングライトの電球               61 灯  (Stringlights)  ※候補 64 のうち 3 を不採用
#   庇のスポット(A)                  5 灯  (MASTER_Light_Bulb)  ※候補 10 のうち 5 を不採用
#   庇のスポット(B)                  7 灯  (Spotlight_Emissive)
#   壁付けランタン                    5 灯  (Lantern)
#   スクーターのヘッドライト               1 灯  (Vespa_Headlight)
#   ストリングライトの色: Blue 19 / Green 11 / Orange 6 / Pink 8 / Red 8 / White 12
#   ※ Paris_StringLights_01_Blue_Color は名前に反して White.png を参照している。
#      実際に描かれている白を採っている(--blue-as-blue で Blue.png の色に切替)。
#
# --- 灯を器具の重心に置いていない理由(重要) ---
# MegaLights の影レイは RAY_FLAG_FORCE_OPAQUE なので、ガラスも笠も影レイを完全に遮る。
# 器具の重心はその器具自身の内側にあるため、重心へ置くと全灯の影レイが自分の器具に
# 当たり、1灯も光らない(絵が暗いだけで例外もログも出ない)。
# そこで灯ごとに下半球 192 方向へレイを撃ち、脱出率が 0.35 を超える位置まで器具の外へ
# 動かしてから採用している。実測された変位は 0.06〜0.52m、脱出率は 0.391〜1.000。
# 動かす向きは真下を最優先にした24方向。真下だけでは足りない — 背の高い街灯は
# 電球が中空の支柱の中にあり、真下へ動かしても管の内側に留まる(28本中12本がそうだった)。
# 脱出率が 0.05 未満か、変位が 0.60m を超えた灯は採用していない
# (でっち上げの位置を置くくらいなら灯を減らす、という方針)。
# 脱出率は近傍の全メッシュを相手に測る。1メッシュだけを見ると誤る — 重心を塞いで
# いるのはまず発光体自身(電球だけを相手にしても 0.000)だが、街灯のガラスだけを
# 相手にすると 0.198 と出て「筒だから真下へ抜ける」という誤った結論になる。
#
# --- Intensity と Range の根拠 ---
#   街灯                       1200.0 lm /  6.28 sr =  191.0 cd, Range  32.5 m  (60W白熱相当の街灯ランタン(笠で下半球へ))
#   ストリングライトの電球                60.0 lm / 12.57 sr =    4.8 cd, Range   5.1 m  (5W級の装飾球)
#   庇のスポット(A)                 400.0 lm /  6.28 sr =   63.7 cd, Range  18.8 m  (庇の小型スポット)
#   庇のスポット(B)                 400.0 lm /  6.28 sr =   63.7 cd, Range  18.8 m  (庇の小型スポット)
#   壁付けランタン                   250.0 lm / 12.57 sr =   19.9 cd, Range  10.5 m  (壁付けの装飾ランタン)
#   スクーターのヘッドライト              700.0 lm /  6.28 sr =  111.4 cd, Range  24.8 m  (スクーターのヘッドライト)
# Range は「その灯の寄与が sRGB で 0.5 階調を切る距離」。トーンマップ入力が
# L/(1.2*2^Exposure) で、拡散面の照度が E=pi*L/albedo(albedo=0.15)なので
# Range = sqrt(I/E)。Exposure=2.0 と対で効くので、露出を変えたら Range も変わる。
# 地面の標本点を覆う灯の最大数は 40。従来経路(MegaLights OFF)のタイル容量64を
# 超えると OFF 側が灯を捨てて絵が壊れ、ON/OFF の比較が成立しなくなる。
#
# --- カメラ ---
# 街灯 28 本の XZ を主成分分析して通りの軸を取り、長さ40mの窓に入る灯が
# 最大(96 灯)になる位置を選んだ。地面の高さ 0.232 m は真下へレイを撃って測った値で、
# そこへ目線の高さ 1.65m を足している。前方に入る灯は 98 灯。
# 俯角は「20m 先の路面を見る角度」。灯の重心を狙うと、灯が頭上にあるぶん仰角が
# 上を向き、庇の裏だけが画面を占める絵になる(最初にそれで失敗した)。
# Yaw は +Z を0度、+X を90度として測る(atan2(dx,dz) であって atan2(dz,dx) ではない)。

[Scene]
Name = Bistro (McGuire) - Exterior (Night)
# 器具光を主役にする露出。値が大きいほど暗く写る(写真のEVと同じ向き)。
# 石畳(albedo 0.15)が街灯直下で受ける照度から、中間グレー 0.18 に載る値として導出した。
# 自動露出を切って使うこと(構図で露出が振れると A/B 比較が成立しない)。
Exposure = 2.0
# 既定のまま。夜空の寄与は街灯より数桁小さいので、ここを動かしても絵はほぼ変わらない。
IBLIntensity = 0.5
# 色付きの電球(緑・赤・紫・橙)が芯から白く抜けないもの。既定の AgX はハイライトを
# 白へ脱色するため、ストリングライトの色がこのシーンの見どころとして残らない。
Tonemap = ACES

[Model]
Path = BistroMcGuire/Exterior.kmodel

[Camera]
Position = 9.563, 1.882, -7.097
Yaw = -50.6
Pitch = -4.7

[Sun]
# twilightFactor が厳密に 0 になるのは 19.0 以降。22.0 は完全な夜。
TimeOfDay = 22.0
# Enabled = false にすると月の平行光まで一緒に消える(枠を共有しているため)。
# 月は 0.25 lx で街灯より数桁暗く競合しないので、残して夜の地の明るさを作らせる。
Enabled = true
# 0.25 lx の平行光に影は見えない。カスケードシャドウ4枚ぶんの実行時間を測定から外す。
Shadow = false

