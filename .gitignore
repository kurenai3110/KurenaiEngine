# ビルド生成物
/Build/
/Samples/Sample3D/Build/
/Samples/Sample2D/Build/
/Tools/KurenaiPacker/Build/
/Tools/KurenaiShowEditor/Build/
# シェーダービルドツールの出力。exe/pdbに加えてWindows SDKからコピーした
# dxcompiler.dll(約13.6MB)とdxil.dllが入るため、書き忘れると約19MBが混ざる
/Tools/KurenaiShaderPacker/Build/

# Visual Studio
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb

# VSCode
.vscode/

# 実行時ログ
*.log

# Pythonのバイトコードキャッシュ(Tools/以下のスクリプトが相互importすると生成される)
__pycache__/

# 大容量アセット・サンプルデータ(Engine/Source/Assets等のソースは含める)
/Assets/
/ThirdParty/SourceModels/

# graphify生成物(ナレッジグラフ出力・キャッシュ)・ローカル設定
/graphify-out/
/.graphifyignore

# worktreeの実体(PCごとのローカルな作業コピー。ブランチはoriginに置く)。
# 置き場所はPCによって違う。EnterWorktreeツールは .claude/worktrees/ に作る
# (このPCの実測で9.97GB / 13543ファイル。除外を書き忘れるとコミット対象に入る)
/.worktrees/
/.claude/worktrees/

# Claude Codeのローカル状態(PCごとに異なる許可リスト等)。
# 横断的なClaude資産(skills/agents/hooks/Tools・共通CLAUDE.md)は ~/.claude/ にあり、
# そもそもこのリポジトリには存在しない。ここが管理するのはプロジェクト固有の
# CLAUDE.md と .claude/skills/ 配下のスキルだけで、worktreeやcloneに付いてくる必要がある
/.claude/settings.local.json

# 動作確認・解析用のスクリプトと、その出力(PNG/CSV/__pycache__)。
# 使い捨ての検証用でありプロジェクトの成果物ではないため管理しない
/Claude/
