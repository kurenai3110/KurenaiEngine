# ビルド生成物
/Build/
/Samples/Sample3D/Build/
/Samples/Sample2D/Build/
/Tools/KurenaiPacker/Build/
/Tools/KurenaiShowEditor/Build/

# Visual Studio
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb

# VSCode
.vscode/

# 実行時ログ
*.log

# Pythonのバイトコードキャッシュ(Tools/以下のスクリプトが相互importすると生成される)
__pycache__/

# 大容量アセット・サンプルデータ(Engine/Source/Assets等のソースは含める)
/Assets/
/ThirdParty/SourceModels/

# graphify生成物(ナレッジグラフ出力・キャッシュ)・ローカル設定
/graphify-out/
/.graphifyignore

# worktreeの実体(PCごとのローカルな作業コピー。ブランチはoriginに置く)
/.worktrees/

# Claude Codeのローカル状態(PCごとに異なる許可リスト等)。
# 横断的なClaude資産(skills/agents/hooks/Tools・共通CLAUDE.md)は ~/.claude/ にあり、
# そもそもこのリポジトリには存在しない。ここが管理するのはプロジェクト固有の
# CLAUDE.md と .claude/skills/build-run だけで、worktreeやcloneに付いてくる必要がある
/.claude/settings.local.json
