      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>NDEBUG;UNICODE;_UNICODE;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\KurenaiEngine\Source\Library;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <AdditionalDependencies>d3dcompiler.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <!-- dxcompiler.dll(SM 6.xのコンパイラ本体)とdxil.dll(署名用)をこのツールの隣へ置く。
         【エンジン側ではなくここへ置く】実行時コンパイルを廃止したので、dxcが要るのは
         ビルド時のこのツールだけになった。エンジンの配布物からは外れる。
         「dxcのバージョン = Windows SDKのバージョン」という制約も、実行環境ではなく
         ビルドマシンの話になる(SDKが古いとSM 6.6のバリアントが焼けず、bindlessが無効になる)。
         見つからない場合もビルドは止めない(SM 5.0のバリアントだけを焼いて縮退する) -->
    <PostBuildEvent>
      <Command>set DXC_BIN=$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64
if exist "%DXC_BIN%\dxcompiler.dll" (xcopy /Y /D "%DXC_BIN%\dxcompiler.dll" "$(OutDir)") else (echo [警告] dxcompiler.dll が "%DXC_BIN%" に見つかりません。SM 6.xのバリアントを焼けません)
if exist "%DXC_BIN%\dxil.dll" (xcopy /Y /D "%DXC_BIN%\dxil.dll" "$(OutDir)") else (echo [警告] dxil.dll が "%DXC_BIN%" に見つかりません。DXILが未署名になります)
exit /b 0</Command>
      <Message>dxcランタイム(dxcompiler.dll/dxil.dll)をOutDirへコピー</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Source\Main.cpp" />
    <ClCompile Include="Source\ShaderCompiler.cpp" />
    <ClCompile Include="Source\ShaderEntryScanner.cpp" />
    <ClCompile Include="Source\ShaderPackageWriter.cpp" />
