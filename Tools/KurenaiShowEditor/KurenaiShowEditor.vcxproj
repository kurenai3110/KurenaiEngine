  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <!-- ImGuiの実体はKurenaiEngineLibrary.dllが持っている(そちらは__declspec(dllexport)で
           ビルドされる)。ここでdllimportとして宣言することで、エディタのUIはエンジンと
           同じImGuiコンテキスト・同じアロケータの上で描かれる。自前でimgui.cppを
           コンパイルするとコンテキストが2つになって成立しない -->
      <PreprocessorDefinitions>IMGUI_API=__declspec(dllimport);_DEBUG;UNICODE;_UNICODE;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(ProjectDir)Source;$(SolutionDir)..\..\KurenaiEngine\Source\Engine;$(SolutionDir)..\..\KurenaiEngine\Source\Library;$(SolutionDir)..\..\ThirdParty\imgui;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <!-- 標準ショーを書き出すCLIモードの結果を標準出力へ返すためコンソールサブシステム。
           GUIで起動したときはコンソールが1枚余分に出るが、ツールなので許容する -->
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <Manifest>
      <AdditionalManifestFiles>KurenaiShowEditor.manifest</AdditionalManifestFiles>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>IMGUI_API=__declspec(dllimport);NDEBUG;UNICODE;_UNICODE;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(ProjectDir)Source;$(SolutionDir)..\..\KurenaiEngine\Source\Engine;$(SolutionDir)..\..\KurenaiEngine\Source\Library;$(SolutionDir)..\..\ThirdParty\imgui;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
    <Manifest>
      <AdditionalManifestFiles>KurenaiShowEditor.manifest</AdditionalManifestFiles>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <!-- Sample3Dとまったく同じ組み合わせ(DLL・シェーダー・Assets)をOutDirへ揃える。
         プレビューが本番と同じ絵になることがこのツールの前提なので、
         読むシェーダーとアセットも本番と同じものでなければならない -->
    <PostBuildEvent>
      <Command>set KURENAI_BIN=$(ProjectDir)..\..\Build\Bin\$(Platform)\$(Configuration)
xcopy /Y /I /D "%KURENAI_BIN%\KurenaiEngineLibrary\*.dll" "$(OutDir)"
xcopy /Y /I /D "%KURENAI_BIN%\KurenaiEngine3D\*.dll" "$(OutDir)"
xcopy /Y /I /E /D "%KURENAI_BIN%\KurenaiEngine3D\Shaders" "$(OutDir)Shaders\"
xcopy /Y /I /E /D "$(ProjectDir)..\..\Assets\Packed" "$(OutDir)Assets\"
exit /b 0</Command>
      <Message>KurenaiEngineLibrary/3D・シェーダー・AssetsをOutDirへコピー</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
