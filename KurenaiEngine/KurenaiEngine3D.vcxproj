  <ItemDefinitionGroup>
    <!-- HLSLを事前コンパイルして .kshader をOutDirへ生成する。
         【.hlsl はもうコピーしない】実行時コンパイルを廃止したため、出力フォルダの .hlsl は
         誰も読まない。コピーを残すと、古いコピーが残っているのに絵が変わらない、という
         紛らわしい状態を作るだけになる。
         パッカー自身が更新日時を見て増分で動くので、シェーダーが未変更ならすぐ返る。
         【失敗したらビルドを止める】ここでHLSLのコンパイルエラーが出る。
         従来は「C++のビルドが通ってもHLSLは一切検証されていない」状態だった -->
    <PostBuildEvent>
      <Command>"$(ProjectDir)..\Tools\KurenaiShaderPacker\Build\Bin\$(Platform)\$(Configuration)\KurenaiShaderPacker.exe" --input "$(ProjectDir)Shaders\3D" --output "$(OutDir)Shaders" --config $(Configuration)</Command>
      <Message>3DシェーダーをコンパイルしてOutDirへ(.kshader)</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
