// 画素座標からマスクの値を [0,1) で引く。マスクはタイル状に敷き詰める
float MegaLightsBlueNoiseValue(uint2 pixel)
{
    const uint2 p = pixel & kMegaLightsBlueNoiseMask;
    const uint index = p.y * kMegaLightsBlueNoiseSize + p.x;
    const uint packedValue = kMegaLightsBlueNoise[index >> 2u];
    const uint byteValue = (packedValue >> ((index & 3u) * 8u)) & 0xFFu;
    return (float(byteValue) + 0.5f) * (1.0f / 256.0f);
}

